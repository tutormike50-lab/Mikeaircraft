[Unit]
Description=MikeAircraft Link V2 outbound command agent
After=network-online.target bluetooth.target
Wants=network-online.target

[Service]
Type=simple
User=mikeaircraft
Group=mikeaircraft
WorkingDirectory=/opt/mikeaircraft-link-v2/current
EnvironmentFile=/etc/mikeaircraft/link-v2.env
ExecStartPre=/usr/bin/python3 /opt/mikeaircraft-link-v2/current/scripts/link_v2_agent.py --check
ExecStart=/usr/bin/python3 /opt/mikeaircraft-link-v2/current/scripts/link_v2_agent.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mikeaircraft-link-v2/log

[Install]
WantedBy=multi-user.target
