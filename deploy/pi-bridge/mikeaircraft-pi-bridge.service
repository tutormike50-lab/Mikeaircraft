[Unit]
Description=MikeAircraft outbound Pi control bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mikeaircraft
Group=mikeaircraft
WorkingDirectory=/opt/mikeaircraft
EnvironmentFile=/etc/mikeaircraft/pi-bridge.env
ExecStart=/usr/bin/python3 /opt/mikeaircraft/scripts/pi_bridge.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mikeaircraft/var/log /run

[Install]
WantedBy=multi-user.target
